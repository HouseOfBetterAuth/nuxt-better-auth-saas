# Description: Example of .env file
#
# The variables below are read when the app is built (`nuxt build`) or started
# in development (`nuxt dev`), and their values are written into the build.
#
# Runtime variables: every value can also be set when the built server starts
# (`node .output/server/index.mjs`), without being present at build time.
# Nuxt reads them from `NUXT_` + the runtime config key path in SCREAMING_SNAKE_CASE.
# Where that name differs from the build-time one, it is given as `runtime: ...`.
# A runtime variable takes precedence over the value written into the build.
NUXT_NITRO_PRESET=cloudflare-module # node-server (default) or cloudflare-module, build time only

NUXT_APP_URL=http://localhost:3000 # Base URL of your app, runtime: NUXT_PUBLIC_BASE_URL and NUXT_PUBLIC_I18N_BASE_URL
NUXT_APP_NAME=House of BetterAuth # runtime: NUXT_PUBLIC_APP_NAME
NUXT_APP_NOTIFY_EMAIL="noreply@notifications.houseofbetterauth.com" # runtime: NUXT_PUBLIC_APP_NOTIFY_EMAIL
NUXT_APP_CONTACT_EMAIL="admin@houseofbetterauth.com" # runtime: NUXT_PUBLIC_APP_CONTACT_EMAIL
NUXT_APP_REPO=https://github.com/HouseOfBetterAuth/nuxt-better-auth-saas # runtime: NUXT_PUBLIC_APP_REPO
NUXT_APP_STORAGE=r2 # r2, s3 or local, runtime: NUXT_FILE_MANAGER_STORAGE_PROVIDER

# when NUXT_APP_STORAGE is local
# The build-time values also decide which directory is served as public assets.
NUXT_LOCAL_UPLOAD_DIR=./uploads # runtime: NUXT_FILE_MANAGER_STORAGE_LOCAL_UPLOAD_DIR
NUXT_LOCAL_PUBLIC_PATH=/uploads # runtime: NUXT_FILE_MANAGER_STORAGE_LOCAL_PUBLIC_PATH

# Auth
NUXT_BETTER_AUTH_SECRET='' # Secret key for JWT

DATABASE_URL=postgres://postgres:@localhost:5432/houseofbetterauth # runtime: NUXT_DATABASE_URL
NUXT_REDIS_URL=redis://localhost:6379

NUXT_GH_CLIENT_ID=your-github-client-id # runtime: NUXT_GITHUB_CLIENT_ID
NUXT_GH_CLIENT_SECRET=your-github-client-secret # runtime: NUXT_GITHUB_CLIENT_SECRET

NUXT_GOOGLE_CLIENT_ID=your-google-client-id
NUXT_GOOGLE_CLIENT_SECRET=your-google-client-secret

NUXT_RESEND_API_KEY=your-resend-api-key


# PAYMENT
NUXT_PAYMENT=stripe # runtime: NUXT_PUBLIC_PAYMENT

# STRIPE
NUXT_STRIPE_SECRET_KEY=your-stripe-secret-key
NUXT_STRIPE_WEBHOOK_SECRET=your-stripe-webhook-key

# Cloudflare
NUXT_CF_HYPERDRIVE_ID=cloudflare-hyperdrive-id #  Required when using cloudflare-module

# when NUXT_APP_STORAGE is r2
NUXT_CF_ACCOUNT_ID=your_account_id_here # runtime: NUXT_FILE_MANAGER_STORAGE_R2_ACCOUNT_ID
NUXT_CF_ACCESS_KEY_ID=your_access_key_id_here # runtime: NUXT_FILE_MANAGER_STORAGE_R2_ACCESS_KEY_ID
NUXT_CF_SECRET_ACCESS_KEY=your_secret_access_key_here # runtime: NUXT_FILE_MANAGER_STORAGE_R2_SECRET_ACCESS_KEY
# https://dash.cloudflare.com/?to=/:account/r2/api-tokens
NUXT_CF_R2_BUCKET_NAME=your_bucket_name_here # runtime: NUXT_FILE_MANAGER_STORAGE_R2_BUCKET_NAME
NUXT_CF_R2_PUBLIC_URL=your_public_url_here # runtime: NUXT_FILE_MANAGER_STORAGE_R2_PUBLIC_URL

# when NUXT_APP_STORAGE is s3 (runtime variables only)
# NUXT_FILE_MANAGER_STORAGE_S3_REGION=us-east-1 # default us-east-1
# NUXT_FILE_MANAGER_STORAGE_S3_ENDPOINT=https://s3.amazonaws.com # default https://s3.amazonaws.com
# NUXT_FILE_MANAGER_STORAGE_S3_ACCESS_KEY_ID=your_access_key_id_here # required
# NUXT_FILE_MANAGER_STORAGE_S3_SECRET_ACCESS_KEY=your_secret_access_key_here # required
# NUXT_FILE_MANAGER_STORAGE_S3_BUCKET_NAME=your_bucket_name_here # required
# NUXT_FILE_MANAGER_STORAGE_S3_PUBLIC_URL=your_public_url_here


# For testing
NUXT_TEST_DATABASE_URL=postgres://postgres:@localhost:5432/houseofbetterauth_test
NUXT_TEST_APP_URL=http://localhost:3000 # App URL for e2e test
NUXT_TEST_EMAIL=test@houseofbetterauth.com
NUXT_TEST_PASSWORD=test-password
NUXT_ADMIN_EMAIL=admin@houseofbetterauth.com
NUXT_ADMIN_PASSWORD=admin-password